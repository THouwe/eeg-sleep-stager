# Copy to .env and adjust for your machine. The dataset is open-access, so
# there are no secrets here — only machine-local paths and Spark/Java knobs.

# Where raw + processed data live (kept out of git)
DATA_DIR=./data

# Spark / Java (Java 11+ required by Spark 3.5)
JAVA_HOME=/usr/lib/jvm/temurin-11-jdk
SPARK_LOCAL_DIRS=/tmp/spark
PYSPARK_PYTHON=./.venv/bin/python

# Windows only: path to winutils/hadoop shim (see README)
# HADOOP_HOME=C:\hadoop
